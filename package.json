{
  "name": "kpct-website",
  "version": "1.0.0",
  "private": true,
  "description": "Kandhasamy Public Charitable Trust website - React frontend with an Express backend",
  "scripts": {
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install --include=dev",
    "postinstall": "npm run install:backend && npm run install:frontend",
    "install:all": "npm install",
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
