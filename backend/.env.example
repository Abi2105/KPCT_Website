# Port the API listens on
PORT=5000

# Comma-separated list of origins allowed to call the API (dev frontend, prod domain)
CORS_ORIGIN=http://localhost:5173

# Set to "production" to also serve the built frontend from ../frontend/dist
NODE_ENV=development

# --- MySQL --------------------------------------------------------------
# Connection settings for the contact_submissions table.
# These stay server-side only: never copy them into the frontend or prefix
# them with VITE_ (anything VITE_-prefixed is compiled into the public bundle).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=kpct
MYSQL_TABLE=contact_submissions

# --- Admin ---------------------------------------------------------------
# Required to read submissions back via GET /api/contact, sent as the
# `x-admin-key` header. Leave empty to keep that endpoint disabled.
ADMIN_API_KEY=
