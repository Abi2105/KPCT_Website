# Port the API listens on
PORT=5000

# Comma-separated list of origins allowed to call the API (dev frontend, prod domain)
CORS_ORIGIN=http://localhost:5173

# Set to "production" to also serve the built frontend from ../frontend/dist
NODE_ENV=development

# --- Supabase -----------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# SERVICE ROLE key (Project Settings -> API -> service_role).
# It bypasses row level security: keep it server-side only. Never copy it into
# the frontend or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Table that stores contact submissions (see supabase/schema.sql)
SUPABASE_TABLE=contact_submissions

# --- Admin ---------------------------------------------------------------
# Required to read submissions back via GET /api/contact, sent as the
# `x-admin-key` header. Leave empty to keep that endpoint disabled.
ADMIN_API_KEY=
